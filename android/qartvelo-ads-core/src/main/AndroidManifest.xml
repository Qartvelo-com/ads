<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!-- Handles rotation itself; durable state lives outside the activity, so re-creation is safe too. -->
        <activity
            android:name="com.qartvelo.sdk.internal.QartveloAdsActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|navigation"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:theme="@style/QartveloAds.Fullscreen" />
    </application>
</manifest>
