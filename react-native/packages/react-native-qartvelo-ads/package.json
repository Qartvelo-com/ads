{
  "name": "@qartvelo/react-native-ads",
  "version": "0.5.0",
  "description": "Qartvelo Ads React Native plugin for Android and iOS: banner, interstitial and rewarded ads with automatic AdMob fallback.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "qartvelo-react-native-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json",
    "./app.plugin.js": "./app.plugin.js"
  },
  "files": [
    "src",
    "lib",
    "android",
    "react-native.config.js",
    "app.plugin.js",
    "plugin/build",
    "plugin/skadnetwork.json",
    "!android/build",
    "!android/.gradle",
    "!android/.cxx",
    "!android/src/test",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*",
    "ios",
    "RNQartveloAds.podspec",
    "scripts/sync-ios-sdk.cjs",
    "scripts/ios-config.rb",
    "!scripts/test"
  ],
  "scripts": {
    "prepare": "node scripts/sync-ios-sdk.cjs && bob build && npm run build:plugin",
    "build": "node scripts/sync-ios-sdk.cjs && bob build && npm run build:plugin",
    "build:plugin": "tsc -p plugin/tsconfig.build.json",
    "typecheck": "tsc && tsc -p plugin/tsconfig.json",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest",
    "clean": "del-cli lib android/build android/.cxx",
    "prepack": "node scripts/sync-ios-sdk.cjs"
  },
  "keywords": [
    "react-native",
    "android",
    "ios",
    "ads",
    "advertising",
    "qartvelo",
    "admob",
    "banner",
    "interstitial",
    "rewarded",
    "qartvelo"
  ],
  "author": "Qartvelo Ads",
  "license": "MIT",
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.79.0",
    "expo": ">=52.0.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^29.7.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "expo": "~55.0.19",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-builder-bob": "^0.43.1",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "QartveloAdsSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.qartvelo.reactnative"
    },
    "ios": {
      "modulesProvider": {
        "QartveloAds": "RCTQartveloAds"
      },
      "componentProvider": {
        "QartveloAdsBannerView": "RCTQartveloAdsBannerView"
      }
    }
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "testEnvironmentOptions": {
      "customExportConditions": [
        "require",
        "react-native"
      ]
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/"
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "engines": {
    "node": ">= 20.19.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Qartvelo-com/ads.git",
    "directory": "react-native/packages/react-native-qartvelo-ads"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/Qartvelo-com/ads#readme",
  "bugs": {
    "url": "https://github.com/Qartvelo-com/ads/issues"
  }
}
