---
/**
 * Starlight PageTitle override: keeps the default title and adds page actions for AI tools:
 * copy the page as Markdown, open the raw .md, or open the page in ChatGPT / Claude / Perplexity.
 * The .md files are generated by src/pages/[...slug].md.ts.
 */
import Default from '@astrojs/starlight/components/PageTitle.astro';

const { entry } = Astro.locals.starlightRoute;
const isSplash = entry.data.template === 'splash';
const slug = entry.id === 'index' ? 'index' : entry.id.replace(/\/index$/, '');
const mdPath = `/${slug}.md`;
const mdUrl = new URL(mdPath, Astro.site ?? Astro.url).href;
const prompt = `Read ${mdUrl} so I can ask questions about it. It is part of the Qartvelo Ads developer docs (index: ${new URL('/llms.txt', Astro.site ?? Astro.url).href}).`;
const q = encodeURIComponent(prompt);
const assistants = [
	{ label: 'Open in ChatGPT', href: `https://chatgpt.com/?hints=search&q=${q}` },
	{ label: 'Open in Claude', href: `https://claude.ai/new?q=${q}` },
	{ label: 'Open in Perplexity', href: `https://www.perplexity.ai/search?q=${q}` },
];
---

<Default />
{
	!isSplash && (
		<div class="page-actions not-content" data-md-url={mdPath}>
			<button type="button" class="copy-md" aria-live="polite">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></svg>
				<span>Copy page</span>
			</button>
			<a href={mdPath}>View as Markdown</a>
			<details>
				<summary>Ask AI about this page</summary>
				<div class="menu">
					{assistants.map((a) => (
						<a href={a.href} target="_blank" rel="noopener noreferrer">{a.label}</a>
					))}
				</div>
			</details>
		</div>
	)
}

<script>
	for (const root of document.querySelectorAll<HTMLElement>('.page-actions')) {
		const button = root.querySelector<HTMLButtonElement>('.copy-md');
		const label = button?.querySelector('span');
		button?.addEventListener('click', async () => {
			if (!label) return;
			try {
				const res = await fetch(root.dataset.mdUrl ?? '');
				if (!res.ok) throw new Error(String(res.status));
				await navigator.clipboard.writeText(await res.text());
				label.textContent = 'Copied';
			} catch {
				label.textContent = 'Copy failed';
			}
			setTimeout(() => (label.textContent = 'Copy page'), 2000);
		});
	}
</script>
